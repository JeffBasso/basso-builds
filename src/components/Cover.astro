---
import { url } from '../lib/url';
// Changes on every build, so a replaced image (same file name) is never served from cache.
const build = (import.meta.env.BUILD_ID ?? Date.now().toString(36));
// Generated circuit-board cover art, stable per seed, so cards look finished
// before there are photos. Pass `image` to use a real picture instead.
interface Props {
  seed: string;
  image?: string;
  alt?: string;
  ratio?: string;   // CSS aspect-ratio, e.g. "16 / 10" or "1"
  label?: string;   // big overlay text, e.g. "07"
}
const { seed, image, alt = '', ratio = '16 / 10', label } = Astro.props;

// Small seeded PRNG (mulberry32 over a string hash)
let h = 2166136261;
for (const c of seed) { h ^= c.charCodeAt(0); h = Math.imul(h, 16777619); }
let s = h >>> 0;
const rnd = () => { s = (s + 0x6d2b79f5) >>> 0; let t = s; t = Math.imul(t ^ (t >>> 15), t | 1); t ^= t + Math.imul(t ^ (t >>> 7), t | 61); return ((t ^ (t >>> 14)) >>> 0) / 4294967296; };

const W = 320, H = 200, G = 20;
const traces: string[] = [];
const pads: { x: number; y: number }[] = [];
for (let i = 0; i < 14; i++) {
  let x = Math.round(rnd() * (W / G)) * G;
  let y = Math.round(rnd() * (H / G)) * G;
  let d = `M${x} ${y}`;
  pads.push({ x, y });
  for (let k = 0; k < 4; k++) {
    const len = (1 + Math.floor(rnd() * 4)) * G;
    const dir = Math.floor(rnd() * 4);
    if (dir === 0) x += len; else if (dir === 1) x -= len; else if (dir === 2) y += len; else y -= len;
    // 45-degree jog, like a real routed trace
    const j = G * (rnd() > 0.5 ? 1 : -1);
    if (rnd() > 0.6) { x += j; y += j; }
    d += ` L${x} ${y}`;
  }
  pads.push({ x, y });
  traces.push(d);
}
const chipX = 40 + Math.floor(rnd() * 8) * G, chipY = 40 + Math.floor(rnd() * 3) * G;
const hue = Math.floor(rnd() * 3); // three board tints
const boards = ['#0f3b27', '#123326', '#0d2f2a'];
---
{image ? (
  <img class="cover" src={image.startsWith('/') ? `${url(image)}?v=${build}` : image} alt={alt} loading="lazy" style={`aspect-ratio:${ratio}`} />
) : (
  <svg class="cover" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" role="img" aria-label={alt} style={`aspect-ratio:${ratio}`}>
    <rect width={W} height={H} fill={boards[hue]} />
    <g stroke="#2b6b4b" stroke-width="0.6" opacity="0.5">
      {Array.from({ length: W / G + 1 }, (_, i) => <line x1={i * G} y1="0" x2={i * G} y2={H} />)}
    </g>
    <g fill="none" stroke="#d08a45" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" opacity="0.9">
      {traces.map((d) => <path d={d} />)}
    </g>
    <g fill="#e8b27a">
      {pads.map((p) => <circle cx={p.x} cy={p.y} r="4.5" />)}
    </g>
    <g fill="#0b1f16">
      {pads.map((p) => <circle cx={p.x} cy={p.y} r="1.8" />)}
    </g>
    <rect x={chipX} y={chipY} width="60" height="60" rx="3" fill="#121614" stroke="#3a4a42" />
    <g fill="#b9c2bd">
      {Array.from({ length: 6 }, (_, i) => <>
        <rect x={chipX + 6 + i * 9} y={chipY - 6} width="4" height="6" />
        <rect x={chipX + 6 + i * 9} y={chipY + 60} width="4" height="6" />
      </>)}
    </g>
    {label && <text x={W - 14} y={H - 14} text-anchor="end" font-family="Anton, Impact, sans-serif" font-size="64" fill="#ffffff" opacity="0.92">{label}</text>}
  </svg>
)}

<style>
  .cover { width: 100%; height: auto; object-fit: cover; background: #0f3b27; }
</style>

---
import { statusLabel } from '../lib/url';
interface Props { status: string }
const { status } = Astro.props;
const tone = ['done', 'published'].includes(status) ? 'ok' : ['planning', 'planned'].includes(status) ? 'idle' : 'live';
---
<span class={`status meta ${tone}`}>{statusLabel[status] ?? status}</span>

<style>
  .status { display: inline-flex; align-items: center; gap: .4rem; white-space: nowrap; }
  .status::before { content: ''; width: .45rem; height: .45rem; background: var(--muted); }
  .live { color: var(--copper); }
  .live::before { background: var(--copper); }
  .ok { color: var(--accent-ink); }
  .ok::before { background: var(--accent); }
</style>

---
// The old project summary page now forwards to the project's first chapter, which carries the
// overview and spec sheet. Kept so old links and bookmarks still land in the right place.
import { getCollection } from 'astro:content';
import { projectStart } from '../../../lib/start';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({ params: { project: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
const to = await projectStart(project.id);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{project.data.title} · Basso Builds</title>
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <link rel="canonical" href={to} />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <p><a href={to}>{project.data.title}: start reading →</a></p>
  </body>
</html>

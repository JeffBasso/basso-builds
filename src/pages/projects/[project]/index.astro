---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Status from '../../../components/Status.astro';
import Video from '../../../components/Video.astro';
import Row from '../../../components/Row.astro';
import { url } from '../../../lib/url';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({ params: { project: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const chapters = (await getCollection('chapters'))
  .filter((c) => c.data.project.id === project.id)
  .sort((a, b) => a.data.order - b.data.order);
const slug = (id: string) => id.split('/').pop();
const done = chapters.filter((c) => c.data.status === 'published').length;
---
<Base title={project.data.title} description={project.data.tagline}>
  <article class="wrap">
    <header class="head">
      <span class="label">{project.data.tags.slice(0, 3).join(' · ')}</span>
      <h1 class="display">{project.data.title}</h1>
      <p class="tagline">{project.data.tagline}</p>
      <div class="metaline">
        <Status status={project.data.status} />
        <span class="meta">{done} of {chapters.length} chapters published</span>
        {project.data.target && <span class="meta">Target {project.data.target}</span>}
        {project.data.repo && <a class="meta link" href={project.data.repo}>Source on GitHub →</a>}
      </div>
    </header>

    <div class="layout">
      <div class="main">
        <Video video={project.data.video} title={project.data.title} />
        <div class="prose"><Content /></div>
      </div>
      <aside>
        {project.data.stats.length > 0 && (
          <div class="spec">
            <div class="spec-head">Spec sheet</div>
            <dl>
              {project.data.stats.map((s) => (<div><dt class="meta">{s.label}</dt><dd>{s.value}</dd></div>))}
            </dl>
          </div>
        )}
        <div class="tags">
          {project.data.tags.map((t) => <span>{t}</span>)}
        </div>
      </aside>
    </div>

    <div class="sec" id="chapters"><h2>Build chapters</h2><span class="meta">{chapters.length} in order</span></div>
    <section class="list2">
      {chapters.map((c) => (
        <Row href={url(`projects/${project.id}/${slug(c.id)}/`)} seed={c.id} cover={c.data.cover} label={`Chapter ${c.data.order}`} title={c.data.title} summary={c.data.summary}>
          <Status status={c.data.status} />
        </Row>
      ))}
    </section>
  </article>
</Base>

<style>
  .head { padding: 2.25rem 0 1.75rem; display: grid; gap: .8rem; border-bottom: 1px solid var(--line); margin-bottom: 2rem; }
  .head h1 { font-size: clamp(2.8rem, 7vw, 4.6rem); }
  .tagline { margin: 0; font-size: 1.15rem; line-height: 1.55; max-width: 46rem; }
  .metaline { display: flex; flex-wrap: wrap; gap: 1.25rem; align-items: center; }
  .link { color: var(--accent-ink); }
  .layout { display: grid; gap: 2rem; }
  @media (min-width: 900px) { .layout { grid-template-columns: minmax(0, 1fr) 280px; gap: 2.5rem; } }
  .main { min-width: 0; }
  .spec { border-top: 4px solid var(--accent); background: var(--panel); }
  @media (min-width: 900px) { aside { position: sticky; top: 64px; align-self: start; } }
  .spec-head { font: 800 .78rem/1 var(--sans); letter-spacing: .1em; text-transform: uppercase; color: var(--ink); padding: .9rem 1rem .4rem; }
  dl { margin: 0; }
  dl div { padding: .6rem 1rem; border-bottom: 1px solid var(--line); display: grid; gap: .15rem; }
  dl div:last-child { border-bottom: 0; }
  dd { margin: 0; color: var(--ink); font-weight: 600; font-size: .94rem; line-height: 1.4; }
  .tags { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: 1rem; }
  .tags span { font: 500 .7rem/1 var(--mono); letter-spacing: .04em; padding: .4rem .5rem; border: 1px solid var(--line); color: var(--text); }
  .list2 { display: grid; column-gap: 2.5rem; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 820px) { .list2 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>

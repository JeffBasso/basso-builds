---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Cover from '../components/Cover.astro';
import Status from '../components/Status.astro';
import { projectStart } from '../lib/start';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const chapters = await getCollection('chapters');
const start = Object.fromEntries(await Promise.all(projects.map(async (p) => [p.id, await projectStart(p.id)])));
const countOf = (id: string) => chapters.filter((c) => c.data.project.id === id).length;
const publishedOf = (id: string) => chapters.filter((c) => c.data.project.id === id && c.data.status === 'published').length;

// Hero traces: drawn on a 20 unit grid with 45 degree jogs, like routed copper.
const traces = [
  'M1200 100 H1020 L960 160 V300 L900 360 H760',
  'M1200 180 H1100 L1060 220 H900',
  'M1200 300 H1140 L1080 360 V460 L1040 500 H820',
  'M1200 420 H1160 L1120 460',
  'M980 0 V60 L940 100 H820',
  'M700 520 V440 L660 400 H560',
];
const pads = [[760, 360], [900, 220], [820, 500], [1120, 460], [820, 100], [560, 400]];
---
<Base title="Basso Builds">
  <script is:inline>document.documentElement.classList.add('js')</script>

  <section class="hero" data-hero>
    <svg class="layer far" viewBox="0 0 1200 520" preserveAspectRatio="xMaxYMid slice" aria-hidden="true">
      <defs>
        <pattern id="bp-grid" width="20" height="20" patternUnits="userSpaceOnUse">
          <path d="M20 0H0V20" fill="none" stroke="var(--grid)" stroke-width="1" />
        </pattern>
        <pattern id="bp-grid-major" width="100" height="100" patternUnits="userSpaceOnUse">
          <path d="M100 0H0V100" fill="none" stroke="var(--line)" stroke-width="1" />
        </pattern>
      </defs>
      <rect width="1200" height="520" fill="url(#bp-grid)" />
      <rect width="1200" height="520" fill="url(#bp-grid-major)" />
    </svg>

    <svg class="layer mid" viewBox="0 0 1200 520" preserveAspectRatio="xMaxYMid slice" aria-hidden="true">
      <g fill="none" stroke="var(--copper)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        {traces.map((d, i) => <path d={d} pathLength="1" style={`--i:${i}`} />)}
      </g>
      <g>
        {pads.map(([x, y], i) => (
          <g class="pad" style={`--i:${i}`}>
            <circle cx={x} cy={y} r="8" fill="var(--copper)" />
            <circle cx={x} cy={y} r="3" fill="var(--bg)" />
          </g>
        ))}
      </g>
    </svg>

    <div class="wrap copy">
      <h1>All projects</h1>
      <p>Hardware projects documented end to end, with the parts, the boards, the enclosure, the firmware and video of every step, so you can build your own.</p>
    </div>

    <svg class="layer near" viewBox="0 0 160 160" aria-hidden="true">
      <circle cx="80" cy="80" r="62" fill="none" stroke="var(--copper)" stroke-width="2" opacity=".55" />
      <circle cx="80" cy="80" r="40" fill="none" stroke="var(--accent)" stroke-width="2" opacity=".7" />
      <circle cx="80" cy="80" r="22" fill="var(--copper)" />
      <circle cx="80" cy="80" r="9" fill="var(--bg)" />
    </svg>
  </section>

  <section class="wrap">
    <div class="projects" data-projects>
      <div class="rail" aria-hidden="true"><span class="fill"></span></div>
      {projects.map((p) => (
        <article class="project">
          <a class="img shot-frame" href={start[p.id]} tabindex="-1" aria-hidden="true">
            <span class="shot"><Cover seed={p.id} image={p.data.cover} alt="" ratio="16 / 9" /></span>
          </a>
          <div class="body reveal">
            <span class="label">{p.data.tags.slice(0, 3).join(' | ')}</span>
            <h2><a href={start[p.id]}>{p.data.title}</a></h2>
            <div class="metaline">
              <Status status={p.data.status} />
              <span class="meta">{countOf(p.id)} chapters · {publishedOf(p.id)} published</span>
              {p.data.target && <span class="meta">Target {p.data.target}</span>}
            </div>
            <p class="overview">{p.data.tagline}</p>
            {p.data.stats.length > 0 && (
              <dl>
                {p.data.stats.slice(0, 4).map((s) => (<div><dt class="meta">{s.label}</dt><dd>{s.value}</dd></div>))}
              </dl>
            )}
            <a class="go" href={start[p.id]}>Start reading: Chapter 1 →</a>
          </div>
        </article>
      ))}
    </div>
  </section>
</Base>

<script>
  const root = document.documentElement;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Reveal each project as it enters the viewport.
  const articles = Array.from(document.querySelectorAll<HTMLElement>('.project'));
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
    }, { rootMargin: '0px 0px -12% 0px', threshold: 0.08 });
    articles.forEach((a) => io.observe(a));
  } else {
    articles.forEach((a) => a.classList.add('in'));
  }

  if (!reduced) {
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    const projects = document.querySelector<HTMLElement>('[data-projects]');
    let queued = false;
    const frame = () => {
      queued = false;
      const vh = innerHeight;
      if (hero) {
        const r = hero.getBoundingClientRect();
        // Only drive the layers while the hero is on screen.
        if (r.bottom > -100) hero.style.setProperty('--y', String(Math.max(0, -r.top)));
      }
      if (projects) {
        const r = projects.getBoundingClientRect();
        const p = Math.min(1, Math.max(0, (vh * 0.65 - r.top) / r.height));
        projects.style.setProperty('--p', p.toFixed(4));
      }
    };
    const tick = () => { if (!queued) { queued = true; requestAnimationFrame(frame); } };
    addEventListener('scroll', tick, { passive: true });
    addEventListener('resize', tick);
    frame();
  } else {
    root.classList.add('still');
    document.querySelector<HTMLElement>('[data-projects]')?.style.setProperty('--p', '1');
  }
</script>

<style>
  /* ---------- Hero: three planes behind and in front of the headline ---------- */
  .hero {
    --y: 0;
    --ease: cubic-bezier(0.23, 1, 0.32, 1);
    position: relative;
    border-bottom: 2px solid var(--ink);
    padding: clamp(3rem, 8vw, 6.5rem) 0 clamp(3rem, 7vw, 5.5rem);
    overflow: hidden;
    isolation: isolate;
  }
  .layer { position: absolute; pointer-events: none; will-change: transform; }
  .far, .mid { inset: -10% 0; width: 100%; height: 120%; }
  .far { z-index: -3; transform: translate3d(0, calc(var(--y) * 0.12px), 0); }
  .mid {
    z-index: -2; transform: translate3d(0, calc(var(--y) * 0.3px), 0);
    -webkit-mask-image: linear-gradient(to right, transparent 28%, #000 62%);
            mask-image: linear-gradient(to right, transparent 28%, #000 62%);
  }
  .mid path { stroke-dasharray: 1; stroke-dashoffset: 1; animation: draw 1.4s var(--ease) forwards; animation-delay: calc(var(--i) * 90ms + 150ms); }
  .mid .pad { opacity: 0; animation: pop .35s var(--ease) forwards; animation-delay: calc(var(--i) * 90ms + 1000ms); }
  .near {
    z-index: 2; width: clamp(72px, 11vw, 150px); height: auto;
    right: clamp(1rem, 7vw, 7rem); bottom: -1px;
    transform: translate3d(0, calc(var(--y) * -0.18px), 0);
    filter: drop-shadow(0 6px 8px color-mix(in srgb, var(--ink) 18%, transparent));
  }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes pop { from { opacity: 0; transform: scale(.9); } to { opacity: 1; transform: none; } }
  .pad { transform-box: fill-box; transform-origin: center; }

  .copy { display: grid; gap: 1.1rem; position: relative; }
  h1 {
    font: 400 clamp(3rem, 9.5vw, 6.5rem)/.96 var(--display);
    letter-spacing: -0.01em; text-transform: uppercase; text-wrap: balance;
  }
  .copy p { margin: 0; font-size: clamp(1.02rem, 1.6vw, 1.18rem); line-height: 1.6; max-width: 40rem; text-wrap: pretty; }

  /* ---------- Projects: editorial rows with a trace rail ---------- */
  .projects { --p: 0; --ease: cubic-bezier(0.23, 1, 0.32, 1); position: relative; display: grid; gap: clamp(3.5rem, 8vw, 6.5rem); padding: clamp(2.5rem, 6vw, 4.5rem) 0 0; }
  .rail { display: none; }
  .project { min-width: 0; display: grid; gap: 1.4rem; align-content: start; position: relative; }
  .shot-frame { display: block; position: relative; border: 1px solid var(--line); overflow: hidden; background: var(--panel); }
  .shot { display: block; }
  .shot :global(.cover) { transition: filter .15s ease-out; }
  .body { display: grid; gap: .75rem; align-content: start; min-width: 0; }
  h2 { font: 400 clamp(2.1rem, 4.2vw, 3.2rem)/1 var(--display); letter-spacing: -0.005em; text-transform: uppercase; text-wrap: balance; }
  h2 a { transition: color .15s ease-out; }
  h2 a:hover { color: var(--accent-ink); }
  .metaline { display: flex; flex-wrap: wrap; gap: .5rem 1.1rem; align-items: center; }
  .overview { margin: .2rem 0 0; font-size: 1.04rem; line-height: 1.65; max-width: 38rem; text-wrap: pretty; }
  dl { margin: .4rem 0 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid var(--line); }
  dl div { padding: .65rem .6rem .65rem 0; border-bottom: 1px solid var(--line); display: grid; gap: .15rem; }
  dd { margin: 0; color: var(--ink); font-weight: 600; font-size: .92rem; line-height: 1.35; }
  .go {
    justify-self: start; margin-top: .5rem; padding: .8rem 1.1rem;
    background: var(--accent); color: #fff;
    font: 800 .74rem/1 var(--sans); letter-spacing: .08em; text-transform: uppercase;
    transition: transform .12s ease-out, filter .12s ease-out;
  }
  .go:active { transform: translateY(1px) scale(.98); }
  .go:focus-visible, h2 a:focus-visible { outline: 3px solid var(--accent-ink); outline-offset: 3px; }
  @media (hover: hover) and (pointer: fine) {
    .go:hover { filter: brightness(1.12); }
    .img:hover :global(.cover) { filter: brightness(1.05); }
  }

  @media (min-width: 900px) {
    .projects { padding-left: 64px; }
    .project { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(1.5rem, 4vw, 3.5rem); align-items: center; }
    .project:nth-of-type(even) { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
    .project:nth-of-type(even) .img { order: 2; }

    /* The signature: one copper trace runs down the list and lights a pad per project. */
    .rail { display: block; position: absolute; left: 20px; top: clamp(2.5rem, 6vw, 4.5rem); bottom: 0; width: 2px; background: var(--line); }
    .rail .fill { position: absolute; inset: 0; background: var(--copper); transform-origin: top; transform: scaleY(var(--p)); will-change: transform; }
    .project::before {
      content: ''; position: absolute; left: -53px; top: 1.1rem; width: 18px; height: 18px; border-radius: 50%;
      background: var(--bg); border: 2px solid var(--line); transition: border-color .3s ease-out, background-color .3s ease-out;
    }
    .project.in::before { border-color: var(--copper); background: var(--copper); box-shadow: inset 0 0 0 4px var(--bg); }
  }
  @media (max-width: 899px) { .shot-frame { margin-inline: -16px; border-inline: 0; } }

  /* ---------- Entrance states (only when scripted, so no-JS shows everything) ---------- */
  :global(.js) .reveal { opacity: 0; transform: translate3d(0, 14px, 0); transition: opacity .55s var(--ease) .12s, transform .55s var(--ease) .12s; }
  :global(.js) .project.in .reveal { opacity: 1; transform: none; }
  :global(.js) .shot { clip-path: inset(0 100% 0 0); transition: clip-path .8s var(--ease); }
  :global(.js) .project:nth-of-type(even) .shot { clip-path: inset(0 0 0 100%); }
  :global(.js) .project.in .shot { clip-path: inset(0 0 0 0); }

  @media (prefers-reduced-motion: reduce) {
    .mid path { animation: none; stroke-dashoffset: 0; }
    .mid .pad { animation: none; opacity: 1; }
    .layer { transform: none !important; }
    :global(.js) .reveal { transform: none; transition: opacity .3s ease-out; }
    :global(.js) .shot, :global(.js) .project:nth-of-type(even) .shot { clip-path: none; opacity: 0; transition: opacity .3s ease-out; }
    :global(.js) .project.in .shot { opacity: 1; }
    .rail .fill { transform: none; }
  }
  @media (max-width: 700px) {
    .near { display: none; }
    /* Keep the traces off the copy: they live in the right third and the bottom edge only. */
    .mid {
      opacity: .55;
      -webkit-mask-image: linear-gradient(to right, transparent 62%, #000 92%);
              mask-image: linear-gradient(to right, transparent 62%, #000 92%);
    }
  }
</style>

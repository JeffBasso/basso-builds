---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Status from '../components/Status.astro';
import { url } from '../lib/url';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const chapters = await getCollection('chapters');
const countFor = (id: string) => chapters.filter((c) => c.data.project.id === id).length;
---
<Base title="Basso Builds">
  <section class="hero wrap">
    <p class="eyebrow">Build logs · schematics · video</p>
    <h1>Hardware projects you can build yourself.</h1>
    <p class="lede">
      Every project here is documented end to end: why each part was chosen, the circuit boards,
      the enclosure, the firmware, and video of every step, so you can follow along and build your own.
    </p>
  </section>

  <section class="wrap">
    <div class="grid">
      {projects.map((p) => (
        <a class="card" href={url(`projects/${p.id}/`)}>
          <div class="card-top">
            <Status status={p.data.status} />
            <span class="mono count">{countFor(p.id)} chapters</span>
          </div>
          <h2>{p.data.title}</h2>
          <p>{p.data.tagline}</p>
          <ul class="tags">
            {p.data.tags.map((t) => <li>{t}</li>)}
          </ul>
          {p.data.target && <p class="mono target">Target: {p.data.target}</p>}
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .hero { padding: 4rem 16px 2.5rem; }
  @media (min-width: 720px) { .hero { padding: 5.5rem 32px 3rem; } }
  .grid { display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 420px), 1fr)); }
  .card {
    display: flex; flex-direction: column; gap: .25rem;
    padding: 1.5rem; border-radius: 12px; border: 1px solid var(--line);
    background: var(--panel); color: var(--text); text-decoration: none;
    transition: border-color .15s, transform .15s;
  }
  .card:hover { border-color: var(--copper); transform: translateY(-2px); color: var(--text); }
  .card-top { display: flex; justify-content: space-between; align-items: center; }
  .count { font-size: .8rem; color: var(--muted); }
  .card h2 { margin: .9rem 0 .25rem; font-family: var(--display); font-size: 1.6rem; }
  .card p { margin: 0; color: var(--muted); }
  .tags { list-style: none; padding: 0; margin: 1rem 0 0; display: flex; flex-wrap: wrap; gap: .4rem; }
  .tags li { font-family: var(--mono); font-size: .75rem; padding: .15rem .5rem; border-radius: 4px; background: var(--bg); border: 1px solid var(--line); color: var(--muted); }
  .target { margin-top: 1rem !important; font-size: .8rem; }
</style>

---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Cover from '../components/Cover.astro';
import Status from '../components/Status.astro';
import { projectStart } from '../lib/start';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const chapters = await getCollection('chapters');
const start = Object.fromEntries(await Promise.all(projects.map(async (p) => [p.id, await projectStart(p.id)])));
const countOf = (id: string) => chapters.filter((c) => c.data.project.id === id).length;
const publishedOf = (id: string) => chapters.filter((c) => c.data.project.id === id && c.data.status === 'published').length;
---
<Base title="Basso Builds">
  <section class="wrap">
    <header class="head">
      <h1>All projects</h1>
      <p>Hardware projects documented end to end, with the parts, the boards, the enclosure, the firmware and video of every step, so you can build your own.</p>
    </header>

    <div class="grid">
      {projects.map((p) => (
        <article class="project">
          <a class="img" href={start[p.id]}>
            <Cover seed={p.id} image={p.data.cover} alt={p.data.title} ratio="16 / 9" />
          </a>
          <div class="body">
            <span class="label">{p.data.tags.slice(0, 3).join(' | ')}</span>
            <h2><a href={start[p.id]}>{p.data.title}</a></h2>
            <div class="metaline">
              <Status status={p.data.status} />
              <span class="meta">{countOf(p.id)} chapters · {publishedOf(p.id)} published</span>
              {p.data.target && <span class="meta">Target {p.data.target}</span>}
            </div>
            <p class="overview">{p.data.tagline}</p>
            {p.data.stats.length > 0 && (
              <dl>
                {p.data.stats.slice(0, 4).map((s) => (<div><dt class="meta">{s.label}</dt><dd>{s.value}</dd></div>))}
              </dl>
            )}
            <a class="go" href={start[p.id]}>Start reading: Chapter 1 →</a>
          </div>
        </article>
      ))}
    </div>
  </section>
</Base>

<style>
  .head { padding: 2.75rem 0 1.75rem; display: grid; gap: .7rem; border-bottom: 2px solid var(--ink); margin-bottom: 2.25rem; }
  .head h1 { font: 800 clamp(2rem, 4.5vw, 2.6rem)/1.1 var(--sans); letter-spacing: -0.025em; }
  .head p { margin: 0; font-size: 1.08rem; max-width: 46rem; }
  .grid { display: grid; gap: 3rem 2.25rem; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 860px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .project { min-width: 0; display: grid; align-content: start; }
  .img { display: block; border: 1px solid var(--line); }
  .img:hover :global(.cover) { filter: brightness(1.05); }
  .body { padding-top: 1.1rem; display: grid; gap: .7rem; }
  h2 { font: 800 1.7rem/1.15 var(--sans); letter-spacing: -0.02em; }
  h2 a:hover { color: var(--accent-ink); }
  .metaline { display: flex; flex-wrap: wrap; gap: 1.1rem; align-items: center; }
  .overview { margin: .2rem 0 0; font-size: 1.04rem; line-height: 1.6; }
  dl { margin: .3rem 0 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid var(--line); }
  dl div { padding: .65rem .2rem .65rem 0; border-bottom: 1px solid var(--line); display: grid; gap: .15rem; }
  dd { margin: 0; color: var(--ink); font-weight: 600; font-size: .92rem; line-height: 1.35; }
  .go { margin-top: .4rem; font: 700 .76rem/1.3 var(--sans); letter-spacing: .08em; text-transform: uppercase; color: var(--accent-ink); }
  .go:hover { text-decoration: underline; }
</style>

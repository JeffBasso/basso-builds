---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Cover from '../components/Cover.astro';
import Card from '../components/Card.astro';
import Row from '../components/Row.astro';
import Status from '../components/Status.astro';
import { url, statusLabel } from '../lib/url';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const chapters = (await getCollection('chapters')).sort((a, b) => a.data.order - b.data.order);
const [lead, ...others] = projects;
const slug = (id: string) => id.split('/').pop();
const chapterHref = (c: (typeof chapters)[number]) => url(`projects/${c.data.project.id}/${slug(c.id)}/`);
const short = (id: string) => projects.find((p) => p.id === id)?.data.short ?? id;
const chaptersOf = (id: string) => chapters.filter((c) => c.data.project.id === id);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

// "Up next": the first not-yet-published chapters of each project, interleaved.
const queues = projects.map((p) => chaptersOf(p.id).filter((c) => c.data.status !== 'published'));
const upNext: typeof chapters = [];
for (let i = 0; upNext.length < 4 && i < 20; i++) for (const q of queues) if (q[i] && upNext.length < 4) upNext.push(q[i]);
---
<Base title="Basso Builds">
  <div class="wrap">
    <section class="lead">
      <a class="lead-main" href={url(`projects/${lead.id}/`)}>
        <Cover seed={lead.id} image={lead.data.cover} ratio="16 / 9" alt="" />
        <div class="lead-text">
          <span class="label">{lead.data.tags.slice(0, 2).join(' · ')}</span>
          <h1 class="display">{lead.data.title}</h1>
          <p>{lead.data.tagline}</p>
          <div class="lead-meta">
            <Status status={lead.data.status} />
            <span class="meta">{chaptersOf(lead.id).length} chapters</span>
            {lead.data.target && <span class="meta">Target {lead.data.target}</span>}
          </div>
        </div>
      </a>

      <aside class="lead-side">
        {others.map((p) => (
          <Card href={url(`projects/${p.id}/`)} seed={p.id} cover={p.data.cover} label={statusLabel[p.data.status]} title={p.data.title} summary={p.data.tagline} meta={`${chaptersOf(p.id).length} chapters`} />
        ))}
        <div class="about">
          <span class="label">About this site</span>
          <p>Hardware projects documented end to end: why each part was chosen, every board, the enclosure and the firmware, with video of each step.</p>
          <a class="more" href={url('about/')}>Read more →</a>
        </div>
      </aside>
    </section>

    <div class="sec"><h2>Up next</h2><span class="meta">Chapters in progress</span></div>
    <section class="grid4">
      {upNext.map((c) => (
        <Card size="sm" href={chapterHref(c)} seed={c.id} cover={c.data.cover} coverLabel={String(c.data.order).padStart(2, '0')} label={short(c.data.project.id)} title={c.data.title} meta={statusLabel[c.data.status]} />
      ))}
    </section>

    {projects.map((p) => (
      <>
        <div class="sec"><h2>{p.data.short ?? p.data.title}: build chapters</h2><a class="more" href={url(`projects/${p.id}/`)}>View project →</a></div>
        <section class="list2">
          {chaptersOf(p.id).map((c) => (
            <Row href={chapterHref(c)} seed={c.id} cover={c.data.cover} label={`Chapter ${c.data.order}`} title={c.data.title} summary={c.data.summary}>
              <Status status={c.data.status} />
            </Row>
          ))}
        </section>
      </>
    ))}
  </div>
</Base>

<style>
  .lead { display: grid; gap: 2rem; padding-top: 1.75rem; }
  @media (min-width: 900px) { .lead { grid-template-columns: minmax(0, 1.9fr) minmax(0, 1fr); gap: 2.25rem; } }
  .lead-main { display: block; min-width: 0; }
  .lead-text { padding-top: 1.1rem; display: grid; gap: .7rem; }
  .lead h1 { font-size: clamp(2.6rem, 6.5vw, 4.2rem); }
  .lead-main:hover h1 { color: var(--accent-ink); }
  .lead-text p { margin: 0; font-size: 1.12rem; line-height: 1.55; max-width: 40rem; }
  .lead-meta { display: flex; flex-wrap: wrap; gap: 1.25rem; align-items: center; }
  .lead-side { display: grid; gap: 1.75rem; align-content: start; }
  .about { background: var(--tint); padding: 1.1rem 1.2rem; display: grid; gap: .5rem; }
  .about p { margin: 0; font-size: .92rem; line-height: 1.55; }
  .about .more { font: 700 .72rem/1 var(--sans); letter-spacing: .08em; text-transform: uppercase; color: var(--accent-ink); }

  .grid4 { display: grid; gap: 1.5rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 900px) { .grid4 { grid-template-columns: repeat(4, minmax(0, 1fr)); } }

  .list2 { display: grid; column-gap: 2.5rem; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 820px) { .list2 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>

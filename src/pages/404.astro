---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---
<Base title="Page not found">
  <section class="wrap" style="padding:4.5rem 16px">
    <span class="label">404</span>
    <h1 class="display" style="font-size:clamp(2.6rem,7vw,4.4rem);margin:.6rem 0 1rem">That page isn't built yet.</h1>
    <p style="font-size:1.15rem;margin:0">It may be a chapter that's still coming, or a link that moved.</p>
    <p style="margin-top:2rem"><a class="label" href={url('/')}>← Back to all projects</a></p>
  </section>
</Base>

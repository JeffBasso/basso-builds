---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---
<Base title="Page not found">
  <section class="wrap narrow" style="padding:5rem 16px">
    <p class="eyebrow">404</p>
    <h1>That page isn't built yet.</h1>
    <p class="lede">It may be a chapter that's still coming, or a link that moved.</p>
    <p style="margin-top:2rem"><a href={url('/')}>← Back to all projects</a></p>
  </section>
</Base>
